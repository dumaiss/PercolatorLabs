	(text_box "Interrupt Selection Logic\nIf VDP is selected and writing\nto the VDP and address line 2 is\nasserted, then we are writing a \nbit to the INT MODE select latch\n\nUpon interrupt from the VDP,\n/NMI or /INT is asserted. The \ndiode is there to ensure the \ninterrupt lines are tri-state when\nthere is no interrupt active\n\nDefault is INT"
		(exclude_from_sim no)
		(at 38.1 167.64 0)
		(size 154.94 182.88)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
