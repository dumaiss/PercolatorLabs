	(text_box "Interrupt Selection Logic\nIf VDP is selected and writing\nto the VDP and address line 1 is\nasserted, then we are writing a \nbit to the INT MODE select latch\n\nUpon interrupt from the VDP,\n/NMI or /INT is asserted. The \ndiode is there to ensure the \ninterrupt lines are tri-state when\nthere is no interrupt active\n\nDefault is NMI"
		(exclude_from_sim no)
		(at 12.7 90.17 0)
		(size 127 139.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dac321f3-6d57-4075-b11e-c991bbe95870")
	)
	(text_box "CPU Interface\n\nData bus\nPort A0/A1/A2 --> VDC Active\nA0 --> CPU Interface Mode\nA1 --> Select Interrupt Mode (0 = NMI / 1 = INT)"
		(exclude_from_sim no)
		(at 12.7 13.335 0)
		(size 127 75.565)
		(margins 0.9525 0.9525 0.9525 0.9525)
